# C1 Compliance Assistant — example environment.
#
# Copy to `.env` and fill in. NEVER commit a real `.env` (it is gitignored).
# Every var below is consumed by config/settings.yaml via ${VAR:-default} interpolation.
# The local/onprem profiles need NONE of the GCP-specific values, only COMPLIANCE_PROFILE.

# ---------------------------------------------------------------------------
# Profile & project
# ---------------------------------------------------------------------------
# gcp | local | platform | onprem.
# Use 'local' for a WORKING offline run (SQLite FTS5 + deterministic LLM, no GCP SDK).
# 'onprem' is the fail-fast migration target. This is the dev / test default.
COMPLIANCE_PROFILE=local

# GCP project id (gcp/platform profiles only).
GOOGLE_CLOUD_PROJECT=your-gcp-project

# ---------------------------------------------------------------------------
# Local profile stores (optional). Unset => per-package defaults under
# ~/.compliance_advisory/ ; set a path to persist, or ':memory:' for ephemeral.
# ---------------------------------------------------------------------------
# COMPLIANCE_LOCAL_DB=:memory:
# COMPLIANCE_LOCAL_AUDIT=:memory:
# COMPLIANCE_LOCAL_LEDGER=:memory:

# Optional higher-fidelity local: route registry/sessions/memory/ledger to the
# official Firestore emulator (requires the [gcp] extra). Leave unset for SDK-free.
# FIRESTORE_EMULATOR_HOST=localhost:8080

# ---------------------------------------------------------------------------
# Region is PINNED to asia-southeast1 in config/settings.yaml — not an env var.
# Do not add a region override here; residency depends on the pin.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Security / residency (gcp profile)
# ---------------------------------------------------------------------------
# Regional Cloud KMS key for CMEK (projects/.../locations/asia-southeast1/.../cryptoKeys/...)
# COMPLIANCE_KMS_KEY=projects/your-gcp-project/locations/asia-southeast1/keyRings/compliance/cryptoKeys/compliance

# Toggle public-web grounding (the google_search sub-agent). true | false.
COMPLIANCE_GROUNDING_ENABLED=true

# ---------------------------------------------------------------------------
# Agent Search location (gcp/platform): global | us | eu, where the data store was created.
# Unset keeps global; a project whose residency policy refuses global uses us or eu.
# ---------------------------------------------------------------------------
# COMPLIANCE_AGENT_SEARCH_LOCATION=us

# ---------------------------------------------------------------------------
# Freshness ledger + horizon tracker
# ---------------------------------------------------------------------------
# gcp: Firestore, in the database compliance-advisory-<region>. Nothing to set.
# platform: AlloyDB. Full instance URI: projects/.../locations/asia-southeast1/clusters/.../instances/...
# COMPLIANCE_ALLOYDB_URI=projects/your-gcp-project/locations/asia-southeast1/clusters/compliance/instances/primary

# ---------------------------------------------------------------------------
# PII redaction — Sensitive Data Protection / DLP (gcp profile)
# ---------------------------------------------------------------------------
# COMPLIANCE_DLP_INSPECT_TEMPLATE=projects/your-gcp-project/locations/asia-southeast1/inspectTemplates/replace-me
# COMPLIANCE_DLP_DEIDENTIFY_TEMPLATE=projects/your-gcp-project/locations/asia-southeast1/deidentifyTemplates/replace-me

# ---------------------------------------------------------------------------
# Human review hand-off (rule R8) — gcp / platform
# ---------------------------------------------------------------------------
# The human-review-console every escalation is routed to. Under gcp the deployed console is an
# embedded app behind journey-portal's IAP edge, so HUMAN_REVIEW_URL is its edge path and
# HUMAN_REVIEW_IAP_AUDIENCE is the one bearer audience that edge accepts: the IAP OAuth client
# id, never the backend-service path. When the audience is set the router mints a fresh ID token
# for it per submission instead of sending S2S_TOKEN; unset keeps S2S_TOKEN; emptied refuses.
# Under gcp, review routing on needs BOTH (under platform, the URL); either missing refuses at
# boot, and COMPLIANCE_REVIEW_ROUTING=off runs without routing.
# HUMAN_REVIEW_URL=https://rm.example.com/apps/human-review-console/api
# HUMAN_REVIEW_IAP_AUDIENCE=1234567890-fictionaledgeclient.apps.googleusercontent.com
# COMPLIANCE_REVIEW_ROUTING=true

# ---------------------------------------------------------------------------
# Agent Runtime (set AFTER you deploy the reasoningEngine)
# ---------------------------------------------------------------------------
# COMPLIANCE_AGENT_ENGINE=projects/your-gcp-project/locations/asia-southeast1/reasoningEngines/replace-me

# ---------------------------------------------------------------------------
# Optional: point at a non-default settings file.
# ---------------------------------------------------------------------------
# COMPLIANCE_SETTINGS=config/settings.yaml
