# terraform.tfvars.example: fictional sample values. Copy to terraform.tfvars and fill in.
#
# Do NOT commit terraform.tfvars. State every optional control you run or decline, including
# where you agree with the default: agreeing silently and never having chosen look identical
# afterwards. Initialise with a backend first:
#   terraform init -backend-config=bucket=<state-bucket> -backend-config=prefix=compliance-advisory

project_id = "acme-compliance-sg-prod"
org_id     = "123456789012"

region          = "asia-southeast1"
allowed_regions = ["asia-southeast1"]

# REQUIRED, no default. true locks the audit bucket IRREVERSIBLY and needs retention_days >= 2557.
worm_locked    = true
retention_days = 2557

# Where the Agent Search data store lives: global, us or eu. The API reads the same value from
# COMPLIANCE_AGENT_SEARCH_LOCATION.
agent_search_location = "global"

# Project guardrails. true where this stack owns the project; false where another stack does.
manage_org_policies = true
manage_audit_config = true
enable_vpc_sc       = true
access_policy_id    = "987654321098" # numeric ACM policy id (required when enable_vpc_sc = true)

# Model Armor. asia-southeast1 serves no malicious-URI filter: set false there and disclose it.
model_armor_full_capabilities       = true
model_armor_log_sanitize_operations = true

# Firestore (the gcp profile's ledger and tracker). CMEK is allowlist-gated by Google and fixed
# at creation: decide it before the first apply.
firestore_cmek_enabled              = true
firestore_delete_protection_enabled = true
firestore_pitr_enabled              = true

# AlloyDB, for the platform profile only. Bills by the hour while it exists.
enable_alloydb = false
# alloydb_password = "set via TF_VAR_alloydb_password, never in this file"

# Irreversible: creates a folder under the organization. Off unless deliberately chosen.
enable_assured_workloads = false
billing_account          = ""

enable_posture_feed = true

# The runtime identity an embedding portal mints for this app's API (second apply, once known).
additional_serving_service_accounts = []

# The reviewed API image digest, for the daily corpus refresh job; "" for no scheduled refresh.
# It lives in the repository this stack creates, so the value is the `image_registry` output plus
# `/api@sha256:<digest>`: <region>-docker.pkg.dev/<project>/compliance-advisory/api@sha256:...
corpus_refresh_image          = ""
cloud_run_deletion_protection = true

# Cheap runtime controls stay on in the reference; say so rather than inheriting the default.
pii_redaction_enabled = true
